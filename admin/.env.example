# Copy to .env.production (gitignored) and fill in real values before
# building. Both values are public/non-secret -- the same Supabase URL and
# anon key already ship inside the HWC Flutter app's own APK. Never put the
# service_role key here; it belongs only in the Worker as a Cloudflare
# secret (see D:\BKKNEX\workers\bkknex-worker's wrangler secret put
# SUPABASE_SERVICE_ROLE_KEY).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_WORKER_BASE_URL=https://bkknex-health-worker.bkknex369.workers.dev
